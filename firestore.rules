rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /leaderboard/{playerId} {
      // Allow everyone to read the global shared leaderboard
      allow read: if true;

      // Allow players to submit or update their own record with validation
      allow create, update: if request.resource.data.id is string
        && request.resource.data.id == playerId
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 30
        && request.resource.data.avatarLetter is string
        && request.resource.data.avatarLetter.size() <= 2
        && request.resource.data.tier is string;

      allow delete: if false;
    }
  }
}
